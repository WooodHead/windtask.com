---
import ArticleCard from '../components/ArticleCard.astro';
import Base from '../layouts/Base.astro';
import { articleCountLabel, articlePath, categoryPath, categoryTitle, getArticles, groupByCategory } from '../lib/articles';
import { formatDate, site } from '../lib/site';

const articles = await getArticles();
const featured = articles[0];
const rest = articles.slice(1);
const groups = groupByCategory(articles);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.url,
  description: site.description,
};
---

<Base title={site.name} description={site.description} canonical="/">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <section class="hero border-b border-line pb-12 lg:grid lg:grid-cols-[minmax(0,1.25fr)_minmax(16rem,0.75fr)] lg:items-end lg:gap-16">
    <div>
      <p class="kicker">Field notes</p>
      <h1>The session ended. The meter did not.</h1>
    </div>
    <div class="mt-6 lg:mt-0">
      <p class="hero__dek max-w-xl">{site.description}</p>
      <p class="mt-6 flex flex-wrap gap-3">
        <a class="btn btn-primary" href="/articles/">Read the articles</a>
        <a class="btn btn-ghost" href="/categories/">Browse categories</a>
      </p>
    </div>
  </section>

  {
    featured && (
      <section class="mt-12" aria-label="Latest">
        <div class="flex items-baseline justify-between gap-4">
          <p class="kicker">Latest</p>
          <a class="text-sm font-semibold text-link hover:text-link-hover" href="/articles/">
            All articles
          </a>
        </div>
        <a class="feature-card" href={articlePath(featured.id)}>
          <p class="feature-card__meta">
            <span>{categoryTitle(featured.data.category)}</span>
            <time datetime={featured.data.pubDate.toISOString()}>{formatDate(featured.data.pubDate)}</time>
            {featured.data.sample && <span class="meta-pill">Sample</span>}
          </p>
          <h2 class="feature-card__title">{featured.data.title}</h2>
          <p class="feature-card__dek">{featured.data.description}</p>
          <p class="feature-card__cta">Read article</p>
        </a>
        {rest.length > 0 && (
          <div class="mt-8">
            {rest.map((article) => (
              <ArticleCard article={article} />
            ))}
          </div>
        )}
      </section>
    )
  }

  <section class="mt-16" aria-labelledby="shelves-heading">
    <h2 id="shelves-heading" class="font-serif text-[1.7rem] font-medium tracking-tight">Categories</h2>
    <ul class="mt-5 grid gap-4 sm:grid-cols-2">
      {
        groups.map((group) => (
          <li>
            <a class="shelf-card" href={categoryPath(group.slug)}>
              <p class="shelf-card__count">{articleCountLabel(group.articles.length)}</p>
              <h3 class="shelf-card__title">{group.title}</h3>
              <p class="shelf-card__text">{group.description}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
