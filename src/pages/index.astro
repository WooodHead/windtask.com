---
import ArticleCard from '../components/ArticleCard.astro';
import Base from '../layouts/Base.astro';
import { categoryPath, getArticles, groupByCategory } from '../lib/articles';
import { site } from '../lib/site';

const articles = await getArticles();
const featured = articles[0];
const groups = groupByCategory(articles);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.url,
  description: site.description,
};
---

<Base title={site.name} description={site.description} canonical="/">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <section class="max-w-3xl">
    <p class="text-xs tracking-[0.18em] text-copper-deep uppercase">Field notes</p>
    <h1 class="mt-3 font-serif text-4xl leading-[1.05] tracking-tight sm:text-6xl">
      The session ended. The meter did not.
    </h1>
    <p class="mt-5 max-w-2xl text-lg text-muted">{site.description}</p>
    <p class="mt-6 flex flex-wrap gap-4 text-sm">
      <a class="border border-ink bg-ink px-4 py-2 text-paper hover:bg-copper-deep" href="/articles/">Read the articles</a>
      <a class="border border-line px-4 py-2 hover:border-ink" href="/categories/">Browse categories</a>
    </p>
  </section>

  {
    featured && (
      <section class="mt-14" aria-labelledby="latest-heading">
        <div class="flex items-baseline justify-between gap-4">
          <h2 id="latest-heading" class="font-serif text-2xl">
            Latest
          </h2>
          <a class="text-sm text-copper-deep hover:text-copper" href="/articles/">
            All articles
          </a>
        </div>
        <div class="mt-2">
          {articles.map((article) => (
            <ArticleCard article={article} />
          ))}
        </div>
      </section>
    )
  }

  <section class="mt-14" aria-labelledby="shelves-heading">
    <h2 id="shelves-heading" class="font-serif text-2xl">Categories</h2>
    <ul class="mt-4 grid gap-4 sm:grid-cols-2">
      {
        groups.map((group) => (
          <li class="border border-line bg-paper-2 p-5">
            <p class="text-xs tracking-[0.14em] text-muted uppercase">{group.articles.length} articles</p>
            <h3 class="mt-2 font-serif text-2xl">
              <a class="hover:text-copper-deep" href={categoryPath(group.slug)}>
                {group.title}
              </a>
            </h3>
            <p class="mt-2 text-sm text-muted">{group.description}</p>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
