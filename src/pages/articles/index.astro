---
import AdSlot from '../../components/AdSlot.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import PageHeader from '../../components/PageHeader.astro';
import Base from '../../layouts/Base.astro';
import { getArticles } from '../../lib/articles';

const articles = await getArticles();
const description = 'Every note published on Windtask, newest first.';
---

<Base title="Articles" description={description} canonical="/articles/">
  <PageHeader kicker="Index" title="Articles" description={description} />
  <AdSlot />
  {
    articles.length > 0 ? (
      <div class="mt-8">
        {articles.map((article) => (
          <ArticleCard article={article} />
        ))}
      </div>
    ) : (
      <p class="mt-8 text-muted">No articles yet.</p>
    )
  }
</Base>
