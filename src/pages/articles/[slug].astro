---
import { render } from 'astro:content';
import AdSlot from '../../components/AdSlot.astro';
import TocList from '../../components/TocList.astro';
import Base from '../../layouts/Base.astro';
import { articlePath, categoryPath, categoryTitle, getArticles, type Article } from '../../lib/articles';
import { formatDate, readingMinutes, site } from '../../lib/site';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

interface Props {
  article: Article;
}

const { article } = Astro.props;
const { Content, headings } = await render(article);
const articles = await getArticles();
const index = articles.findIndex((item) => item.id === article.id);
const newer = index > 0 ? articles[index - 1] : undefined;
const older = index >= 0 && index < articles.length - 1 ? articles[index + 1] : undefined;
const path = articlePath(article.id);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const canonical = new URL(path, site.url).href;
const minutes = readingMinutes(article.body);
const updated = article.data.updatedDate;
const showUpdated = updated !== undefined && updated.getTime() > article.data.pubDate.getTime();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.data.title,
  description: article.data.description,
  datePublished: article.data.pubDate.toISOString(),
  dateModified: (article.data.updatedDate ?? article.data.pubDate).toISOString(),
  mainEntityOfPage: canonical,
  keywords: article.data.tags.join(', '),
  articleSection: categoryTitle(article.data.category),
  author: { '@type': 'Organization', name: site.name, url: site.url },
  publisher: { '@type': 'Organization', name: site.name, url: site.url },
};
---

<Base
  title={article.data.title}
  description={article.data.description}
  canonical={path}
  ogType="article"
  publishedTime={article.data.pubDate}
  updatedTime={article.data.updatedDate}
  tags={article.data.tags}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="article-layout">
    <header class="article-layout__header">
      <p class="article-kicker">
        <a href={categoryPath(article.data.category)}>{categoryTitle(article.data.category)}</a>
        <time datetime={article.data.pubDate.toISOString()}>{formatDate(article.data.pubDate)}</time>
        <span class="reading-time">{minutes} min read</span>
        {
          showUpdated && updated && (
            <span class="reading-time">
              Updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time>
            </span>
          )
        }
        {article.data.sample && <span class="meta-pill">Sample</span>}
      </p>
      <h1>{article.data.title}</h1>
      <p class="article-dek">{article.data.description}</p>
      {
        article.data.tags.length > 0 && (
          <ul class="mt-5 flex flex-wrap gap-2">
            {article.data.tags.map((tag) => (
              <li class="tag">{tag}</li>
            ))}
          </ul>
        )
      }
    </header>
    <div class="article-layout__ad">
      <AdSlot />
    </div>
    {
      toc.length > 0 && (
        <details class="toc-disclosure">
          <summary>On this page</summary>
          <TocList toc={toc} />
        </details>
      )
    }
    {
      toc.length > 0 && (
        <nav class="toc-sticky" aria-label="On this page">
          <p class="kicker">On this page</p>
          <TocList toc={toc} />
        </nav>
      )
    }
    <div class="article-body article-layout__body">
      <Content />
    </div>
    {
      (older || newer) && (
        <nav class="pager article-layout__pager" aria-label="More articles">
          {
            older && (
              <a class="pager-link" href={articlePath(older.id)}>
                <span class="kicker">Older</span>
                <span class="pager-link__title">{older.data.title}</span>
              </a>
            )
          }
          {
            newer && (
              <a class:list={['pager-link', older && 'sm:text-right', !older && 'sm:col-start-2 sm:text-right']} href={articlePath(newer.id)}>
                <span class="kicker">Newer</span>
                <span class="pager-link__title">{newer.data.title}</span>
              </a>
            )
          }
        </nav>
      )
    }
  </div>
</Base>
