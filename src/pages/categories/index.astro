---
import Base from '../../layouts/Base.astro';
import { categoryPath, getArticles, groupByCategory } from '../../lib/articles';
import { formatDate } from '../../lib/site';

const groups = groupByCategory(await getArticles());
const description = 'Topics on Windtask. Each category is a path on this site, not its own subdomain.';
---

<Base title="Categories" description={description} canonical="/categories/">
  <header class="max-w-3xl">
    <p class="text-xs tracking-[0.18em] text-copper-deep uppercase">Shelves</p>
    <h1 class="mt-3 font-serif text-4xl tracking-tight sm:text-5xl">Categories</h1>
    <p class="mt-4 text-lg text-muted">{description}</p>
  </header>
  <ul class="mt-10 divide-y divide-line border-y border-line">
    {
      groups.map((group) => (
        <li class="grid gap-4 py-6 sm:grid-cols-[14rem_minmax(0,1fr)]">
          <div>
            <h2 class="font-serif text-3xl">
              <a class="hover:text-copper-deep" href={categoryPath(group.slug)}>
                {group.title}
              </a>
            </h2>
            <p class="mt-2 text-sm text-muted">{group.description}</p>
          </div>
          <ul>
            {group.articles.map((article) => (
              <li>
                <a class="flex flex-wrap items-baseline justify-between gap-x-4 py-1 hover:text-copper-deep" href={`/articles/${article.id}/`}>
                  <span>{article.data.title}</span>
                  <time class="text-sm text-muted" datetime={article.data.pubDate.toISOString()}>
                    {formatDate(article.data.pubDate)}
                  </time>
                </a>
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
</Base>
