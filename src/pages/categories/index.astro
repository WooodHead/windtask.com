---
import PageHeader from '../../components/PageHeader.astro';
import Base from '../../layouts/Base.astro';
import { articleCountLabel, articlePath, categoryPath, getArticles, groupByCategory } from '../../lib/articles';
import { formatDateCompact } from '../../lib/site';

const groups = groupByCategory(await getArticles());
const description = 'Topics on Windtask. Each category is a path on this site, not its own subdomain.';
---

<Base title="Categories" description={description} canonical="/categories/">
  <PageHeader kicker="Shelves" title="Categories" description={description} />
  <ul class="mt-10">
    {
      groups.map((group) => (
        <li class="shelf">
          <div>
            <p class="shelf__count">{articleCountLabel(group.articles.length)}</p>
            <h2 class="shelf__title">
              <a href={categoryPath(group.slug)}>{group.title}</a>
            </h2>
            <p class="shelf__text">{group.description}</p>
          </div>
          <ul class="shelf__list">
            {group.articles.map((article) => (
              <li class="shelf__item">
                <a href={articlePath(article.id)}>
                  <span class="shelf__name">{article.data.title}</span>
                  <time datetime={article.data.pubDate.toISOString()}>{formatDateCompact(article.data.pubDate)}</time>
                </a>
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
</Base>
