---
import ArticleCard from '../../components/ArticleCard.astro';
import Base from '../../layouts/Base.astro';
import {
  categoryDescription,
  categoryPath,
  categoryTitle,
  getArticles,
  groupByCategory,
  type CategoryGroup,
} from '../../lib/articles';

export async function getStaticPaths() {
  const groups = groupByCategory(await getArticles());
  return groups.map((group) => ({
    params: { category: group.slug },
    props: { group },
  }));
}

interface Props {
  group: CategoryGroup;
}

const { group } = Astro.props;
const title = categoryTitle(group.slug);
const description = categoryDescription(group.slug);
---

<Base title={title} description={description} canonical={categoryPath(group.slug)}>
  <header class="max-w-3xl">
    <p class="text-xs tracking-[0.18em] text-copper-deep uppercase">
      <a class="hover:text-copper" href="/categories/">Categories</a>
    </p>
    <h1 class="mt-3 font-serif text-4xl tracking-tight sm:text-5xl">{title}</h1>
    <p class="mt-4 text-lg text-muted">{description}</p>
  </header>
  <div class="mt-8">
    {group.articles.map((article) => <ArticleCard article={article} />)}
  </div>
</Base>
