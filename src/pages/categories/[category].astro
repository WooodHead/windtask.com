---
import ArticleCard from '../../components/ArticleCard.astro';
import PageHeader from '../../components/PageHeader.astro';
import Base from '../../layouts/Base.astro';
import {
  categoryDescription,
  categoryPath,
  categoryTitle,
  getArticles,
  groupByCategory,
  type CategoryGroup,
} from '../../lib/articles';

export async function getStaticPaths() {
  const groups = groupByCategory(await getArticles());
  return groups.map((group) => ({
    params: { category: group.slug },
    props: { group },
  }));
}

interface Props {
  group: CategoryGroup;
}

const { group } = Astro.props;
const title = categoryTitle(group.slug);
const description = categoryDescription(group.slug);
---

<Base title={title} description={description} canonical={categoryPath(group.slug)}>
  <PageHeader kicker="Categories" kickerHref="/categories/" title={title} description={description} />
  <div class="mt-8">
    {group.articles.map((article) => <ArticleCard article={article} />)}
  </div>
</Base>
