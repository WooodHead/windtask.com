---
import { articlePath, categoryPath, categoryTitle } from '../lib/articles';
import { formatDateCompact } from '../lib/site';
import type { Article } from '../lib/articles';

interface Props {
  article: Article;
}

const { article } = Astro.props;
---

<article class="article-card">
  <p class="article-card__meta">
    <a class="text-link hover:text-link-hover" href={categoryPath(article.data.category)}>
      {categoryTitle(article.data.category)}
    </a>
    <time datetime={article.data.pubDate.toISOString()}>{formatDateCompact(article.data.pubDate)}</time>
    {article.data.sample && <span class="meta-pill">Sample</span>}
  </p>
  <h2 class="article-card__title">
    <a href={articlePath(article.id)}>{article.data.title}</a>
  </h2>
  <p class="article-card__dek">{article.data.description}</p>
</article>
