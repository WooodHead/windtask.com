---
import { PUBLIC_ADSENSE_CLIENT, PUBLIC_ADSENSE_SLOT } from 'astro:env/client';

interface Props {
  slot?: string;
}

const client = PUBLIC_ADSENSE_CLIENT.trim();
const slot = (Astro.props.slot ?? PUBLIC_ADSENSE_SLOT).trim();
const enabled = client.length > 0 && slot.length > 0;
---

{
  enabled && (
    <aside class="ad-slot" aria-label="Advertisement">
      <p class="ad-slot__label">Advertisement</p>
      <ins
        class="adsbygoogle"
        style="display:block"
        data-ad-client={client}
        data-ad-slot={slot}
        data-ad-format="auto"
        data-full-width-responsive="true"
      />
      <script is:inline>
        window.adsbygoogle = window.adsbygoogle || [];
        window.adsbygoogle.push({});
      </script>
    </aside>
  )
}
