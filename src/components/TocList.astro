---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  toc: Heading[];
  idPrefix?: string;
}

const { toc, idPrefix = '' } = Astro.props;
---

<ol class="toc-list">
  {
    toc.map((heading) => (
      <li>
        <a class:list={[heading.depth === 3 && 'is-sub']} href={`#${idPrefix}${heading.slug}`}>
          {heading.text}
        </a>
      </li>
    ))
  }
</ol>
