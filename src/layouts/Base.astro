---
import '../styles/global.css';
import LangToggle from '../components/LangToggle.astro';
import Seo from '../components/Seo.astro';
import Bi from '../components/Bi.astro';
import { PUBLIC_ADSENSE_CLIENT } from 'astro:env/client';
import { site } from '../lib/site';

interface Props {
  title: string;
  titleZh?: string;
  description: string;
  canonical?: string;
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  updatedTime?: Date;
  tags?: string[];
  noindex?: boolean;
}

const {
  title,
  titleZh,
  description,
  canonical = Astro.url.pathname,
  ogType = 'website',
  publishedTime,
  updatedTime,
  tags,
  noindex = false,
} = Astro.props;

const adsClient = PUBLIC_ADSENSE_CLIENT.trim();
const pathname = Astro.url.pathname;
const adsSrc = `https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${encodeURIComponent(adsClient)}`;
const year = new Date().getUTCFullYear();

const nav = [
  { href: '/articles/', label: 'Articles', labelZh: '文章' },
  { href: '/categories/', label: 'Categories', labelZh: '分类' },
  { href: '/rss.xml', label: 'RSS', labelZh: 'RSS' },
];

const pageTitle = title === site.name ? site.name : `${title} · ${site.name}`;
const pageTitleZh = titleZh ? (titleZh === site.name ? site.name : `${titleZh} · ${site.name}`) : pageTitle;
---

<!doctype html>
<html lang="en" data-title-en={pageTitle} data-title-zh={pageTitleZh}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f7f6f3" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <Seo
      title={title}
      description={description}
      canonical={canonical}
      ogType={ogType}
      publishedTime={publishedTime}
      updatedTime={updatedTime}
      tags={tags}
      noindex={noindex}
    />
    <script is:inline>
      try {
        if (localStorage.getItem('windtask-lang') === 'zh') {
          var root = document.documentElement;
          root.setAttribute('data-lang', 'zh');
          root.lang = 'zh-Hans';
          var zhTitle = root.getAttribute('data-title-zh');
          if (zhTitle) document.title = zhTitle;
        }
      } catch (e) {}
    </script>
    {adsClient && <script is:inline async src={adsSrc} crossorigin="anonymous" />}
  </head>
  <body>
    <a class="skip-link" href="#content"><Bi en="Skip to content" zh="跳到正文" /></a>
    <header class="site-header">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-2.5 sm:px-8 sm:py-3">
        <a class="brand" href="/">
          <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
            <rect width="32" height="32" rx="5" fill="#1c1917"></rect>
            <path
              d="M6 22.5c3.2-.8 5-6.6 8.6-6.6 3 0 4 3.6 7.2 3"
              fill="none"
              stroke="#f6f3ec"
              stroke-width="1.7"
              stroke-linecap="round"></path>
            <path d="M7 10.5h12.5M7 14.2h8" stroke="#9a3412" stroke-width="1.6" stroke-linecap="round"></path>
          </svg>
          Windtask
        </a>
        <div class="flex items-center gap-1 sm:gap-2">
          <LangToggle />
          <nav aria-label="Primary">
            <ul class="flex items-center">
              {
                nav.map((item) => (
                  <li>
                    <a
                      class="nav-link"
                      href={item.href}
                      aria-current={pathname.startsWith(item.href) ? 'page' : undefined}
                    >
                      <Bi en={item.label} zh={item.labelZh} />
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
      </div>
    </header>
    <main id="content" tabindex="-1" class="mx-auto w-full max-w-6xl flex-1 px-4 py-10 outline-none sm:px-8 sm:py-14">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:px-8 sm:grid-cols-[minmax(0,1.4fr)_auto] sm:items-end">
        <div class="max-w-md">
          <p class="font-serif text-xl font-medium tracking-wide">Windtask</p>
          <p class="mt-2 text-sm leading-relaxed text-muted">
            <Bi en={site.description} zh={site.descriptionZh} />
          </p>
        </div>
        <nav aria-label="Footer">
          <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm font-medium">
            {
              nav.map((item) => (
                <li>
                  <a class="text-muted hover:text-ink" href={item.href}>
                    <Bi en={item.label} zh={item.labelZh} />
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
      <div class="border-t border-line">
        <p class="mx-auto max-w-6xl px-4 py-4 text-xs tracking-wide text-muted sm:px-8">
          © {year} {site.name}
        </p>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var KEY = 'windtask-lang';
        function prefixZhIds() {
          document.querySelectorAll('.lang-zh [id]').forEach(function (el) {
            if (el.id.indexOf('zh-') !== 0) el.id = 'zh-' + el.id;
          });
        }
        function apply(lang, persist) {
          var root = document.documentElement;
          var zh = lang === 'zh';
          if (zh) {
            root.setAttribute('data-lang', 'zh');
            root.lang = 'zh-Hans';
          } else {
            root.removeAttribute('data-lang');
            root.lang = 'en';
          }
          var next = zh ? root.getAttribute('data-title-zh') : root.getAttribute('data-title-en');
          if (next) document.title = next;
          if (persist) {
            try {
              localStorage.setItem(KEY, zh ? 'zh' : 'en');
            } catch (e) {}
          }
          document.querySelectorAll('[data-set-lang]').forEach(function (btn) {
            var on = btn.getAttribute('data-set-lang') === (zh ? 'zh' : 'en');
            btn.setAttribute('aria-pressed', on ? 'true' : 'false');
          });
        }
        function syncFromStorage() {
          var stored = 'en';
          try {
            if (localStorage.getItem(KEY) === 'zh') stored = 'zh';
          } catch (e) {}
          apply(stored, false);
        }
        prefixZhIds();
        document.addEventListener('click', function (event) {
          var target = event.target;
          var btn = target && target.closest ? target.closest('[data-set-lang]') : null;
          if (!btn) return;
          apply(btn.getAttribute('data-set-lang') || 'en', true);
        });
        syncFromStorage();
        // Prerender and back-forward cache can restore a page that ran
        // before the visitor changed language. Re-read storage on activation.
        document.addEventListener('prerenderingchange', syncFromStorage);
        window.addEventListener('pageshow', syncFromStorage);
      })();
    </script>
  </body>
</html>
