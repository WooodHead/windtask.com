---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import { PUBLIC_ADSENSE_CLIENT } from 'astro:env/client';
import { site } from '../lib/site';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  updatedTime?: Date;
  tags?: string[];
  noindex?: boolean;
}

const {
  title,
  description,
  canonical = Astro.url.pathname,
  ogType = 'website',
  publishedTime,
  updatedTime,
  tags,
  noindex = false,
} = Astro.props;

const adsClient = PUBLIC_ADSENSE_CLIENT.trim();
const pathname = Astro.url.pathname;
const adsSrc = `https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${encodeURIComponent(adsClient)}`;
const year = new Date().getUTCFullYear();

const nav = [
  { href: '/articles/', label: 'Articles' },
  { href: '/categories/', label: 'Categories' },
  { href: '/rss.xml', label: 'RSS' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f6f3ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141311" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <Seo
      title={title}
      description={description}
      canonical={canonical}
      ogType={ogType}
      publishedTime={publishedTime}
      updatedTime={updatedTime}
      tags={tags}
      noindex={noindex}
    />
    {adsClient && <script is:inline async src={adsSrc} crossorigin="anonymous" />}
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-2.5 sm:px-8 sm:py-3">
        <a class="brand" href="/">
          <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
            <rect width="32" height="32" rx="5" fill="#1c1917"></rect>
            <path
              d="M6 22.5c3.2-.8 5-6.6 8.6-6.6 3 0 4 3.6 7.2 3"
              fill="none"
              stroke="#f6f3ec"
              stroke-width="1.7"
              stroke-linecap="round"></path>
            <path d="M7 10.5h12.5M7 14.2h8" stroke="#9a3412" stroke-width="1.6" stroke-linecap="round"></path>
          </svg>
          Windtask
        </a>
        <nav aria-label="Primary">
          <ul class="flex items-center">
            {
              nav.map((item) => (
                <li>
                  <a
                    class="nav-link"
                    href={item.href}
                    aria-current={pathname.startsWith(item.href) ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>
    <main id="content" tabindex="-1" class="mx-auto w-full max-w-6xl flex-1 px-4 py-10 outline-none sm:px-8 sm:py-14">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:px-8 sm:grid-cols-[minmax(0,1.4fr)_auto] sm:items-end">
        <div class="max-w-md">
          <p class="font-serif text-xl font-medium tracking-wide">Windtask</p>
          <p class="mt-2 text-sm leading-relaxed text-muted">{site.description}</p>
        </div>
        <nav aria-label="Footer">
          <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm font-medium">
            {
              nav.map((item) => (
                <li>
                  <a class="text-muted hover:text-ink" href={item.href}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
      <div class="border-t border-line">
        <p class="mx-auto max-w-6xl px-4 py-4 text-xs tracking-wide text-muted sm:px-8">
          © {year} {site.name}
        </p>
      </div>
    </footer>
  </body>
</html>
